# Copy to .env and fill in only what you use. Every integration is optional except a real
# job posting and a real GitHub repository, which you provide in the UI.

# --- Database (SQLite only) ------------------------------------------------------------
# DATABASE_URL=sqlite:///D:/CareerCoach/CareerCoach/data/career_coach.db   (default: ./data/career_coach.db)
DATABASE_URL=

# Secret used to encrypt stored credentials. Auto-generated into data/keys/app_secret.key if empty.
APP_SECRET_KEY=
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://localhost:3000
# Public https URL GitHub can reach for webhooks (e.g. https://xxxx.ngrok-free.app). Empty = SHA polling only.
APP_PUBLIC_URL=

# --- GitHub -----------------------------------------------------------------------------
# Optional: a token can also be pasted in Settings (encrypted at rest). Fine-grained PAT recommended:
#   Contents: read, Metadata: read  (+ Issues: read/write for gap tasks, Webhooks: read/write for auto webhook)
GITHUB_TOKEN=
# Webhook HMAC secret. If empty, a per-user secret is generated when you create a webhook from the UI.
GITHUB_WEBHOOK_SECRET=
POLL_INTERVAL_SECONDS=60
MAX_FILES_PER_SCAN=600
MAX_FILE_BYTES=200000

# --- LLM (OpenAI-compatible) -------------------------------------------------------------
# Examples: OpenCode Zen https://opencode.ai/zen/v1 | Groq https://api.groq.com/openai/v1
#           OpenRouter https://openrouter.ai/api/v1 | Ollama http://127.0.0.1:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=120

# --- Speech-to-text ------------------------------------------------------------------------
# local_whisper (openai-whisper + ffmpeg, audio stays local) | openai_compatible | none
TRANSCRIPTION_PROVIDER=local_whisper
WHISPER_MODEL=base
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3

# --- Optional job providers -----------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
SERPAPI_API_KEY=

# --- Storage / limits ---------------------------------------------------------------------
# MEDIA_STORAGE_DIR=./data/media
MAX_UPLOAD_BYTES=25000000
AGENT_MAX_TOOL_CALLS=400
AGENT_MAX_SECONDS=600
AGENT_MAX_LLM_CALLS=30

# --- Sandbox (Docker required) ------------------------------------------------------------
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=300

# --- Passport -----------------------------------------------------------------------------
PASSPORT_VALIDITY_DAYS=180
